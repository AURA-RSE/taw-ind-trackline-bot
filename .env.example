# ---- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ----
WHATSAPP_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
# Any random string; paste the same value into Meta's webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=your_random_verify_token
# App settings > Basic > App secret. Enables X-Hub-Signature-256 verification (recommended)
WHATSAPP_APP_SECRET=your_app_secret
GRAPH_API_VERSION=v21.0

# Ops team WhatsApp number for escalation alerts, digits only with country code.
# TEST/OPTED-IN ONLY. It must also be added as a test recipient in Meta.
OPS_WHATSAPP_NUMBER=15550100199

# ---- Vapi (dashboard.vapi.ai > API Keys > Private) ----
VAPI_API_KEY=your_vapi_private_key
# Sent by Vapi as X-Vapi-Secret on every request; set the same value in Vercel
VAPI_SHARED_SECRET=your_random_secret
VAPI_SERVER_URL=https://your-project.vercel.app/api/vapi
OPENAI_MODEL=gpt-4o-mini
# Human support line for voice transfers. TEST NUMBER ONLY, E.164
OPS_PHONE_NUMBER=+15550100199

TIMEZONE=Africa/Lagos

# ---- Twilio WhatsApp sandbox (free alternative to the Meta Cloud API) ----
# Webhook: Twilio Console > Messaging > Try it out > Send a WhatsApp message > Sandbox settings
#   "When a message comes in" = https://<app>.vercel.app/api/twilio-whatsapp (POST)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
# Public URL of the deployment (used to validate Twilio signatures)
PUBLIC_BASE_URL=https://your-project.vercel.app
